# "tls internal" makes Caddy its own certificate authority. Install its root certificate on each
# clinic phone once (docs/deployment.md), or use a real domain with a public certificate instead.
{$SETU_HOST:setu.local} {
	tls internal
	encode gzip

	handle /api/* {
		reverse_proxy server:8080
	}
	handle_path /audio/* {
		root * /srv/audio
		file_server
	}
	handle {
		root * /srv/app
		try_files {path} /index.html
		file_server
	}
}
